+name: PlanTo3D Tapir (Archicad 29 Windows)
+
+# Builds only the Archicad 29 Windows add-on (TapirAddOn_AC29_Win.apx) with the
+# CreateCurtainWalls command used by PlanTo3D. Runs on every push and from the
+# Actions tab ("Run workflow"). Download the result under "Artifacts".
+on:
+  push:
+  workflow_dispatch:
+
+jobs:
+  build_ac29_win:
+    runs-on: windows-2022
+    steps:
+    - name: Checkout repo
+      uses: actions/checkout@v4
+    - name: Download Archicad 29 Development Kit
+      run: python archicad-addon/Tools/download_and_unzip.py https://github.com/GRAPHISOFT/archicad-api-devkit/releases/download/29.3000/API.Development.Kit.WIN.29.3000.zip archicad-addon/Build/DevKits/AC29
+    - name: Generate project
+      run: cmake -B archicad-addon/Build -G "Visual Studio 17 2022" -A "x64" -T "v143" -DAC_VERSION=29 -DAC_API_DEVKIT_DIR="archicad-addon/Build/DevKits/AC29/Support" archicad-addon
+    - name: Build
+      run: cmake --build archicad-addon/Build --config RelWithDebInfo
+    - name: Upload add-on
+      uses: actions/upload-artifact@v4
+      with:
+        name: TapirAddOn_AC29_Win_PlanTo3D
+        path: archicad-addon/Build/RelWithDebInfo/TapirAddOn_AC29_Win.apx
